APP_NAME="EduVault Pro"
APP_ENV=testing
APP_KEY=base64:Xu1A8h98+wJwGq74vQLTcQh8JYp8uaR+p5L8vQzN6aY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Testing Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Session Driver for Testing
SESSION_DRIVER=array

# Cache Driver for Testing
CACHE_STORE=array

# Queue Driver for Testing
QUEUE_CONNECTION=sync

# Mail Driver for Testing
MAIL_MAILER=array

# Filesystem Disk for Testing
FILESYSTEM_DISK=local

# Broadcasting Driver for Testing
BROADCAST_CONNECTION=null

# Disable external API calls during testing
VITE_APP_NAME="${APP_NAME}"
